<h1>Add a movie to your <%= @list.name %> list</h1>
<%= simple_form_for [@list, @bookmark] do |f| %>
  <%= f.association :movie, prompt: "Select a movie" %>
  <%= f.input :comment, placeholder: "e.g. Recommended by John" %>
  <%= f.button :submit, "Add Bookmark", class: "btn btn-primary" %>
<% end %>
<br>
<%= link_to "Cancel", list_path(@list) %>
