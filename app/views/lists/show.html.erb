<h1><%= @list.name %></h1>
<h3>Bookmarks</h3>
<%= cl_image_tag @list.photo.key, height: 300, width: 200, crop: :fill %>
<% if @list.bookmarks.empty? %>
  <p>No bookmarks yet.</p>
<% else %>
  <ul>
    <% @list.bookmarks.each do |bookmark| %>
      <li style="margin-bottom: 10px;">
        <strong><%= bookmark.movie.title %></strong>
        <span><%= bookmark.comment %></span>
        <%= button_to "Delete",
            bookmark_path(bookmark),
            method: :delete,
            form: { style: "display:inline-block;", data: { turbo_confirm: "Are you sure you want to delete this bookmark?" } },
            class: "btn btn-danger"
        %>
      </li>
    <% end %>
  </ul>
<% end %>
<hr>
<%= link_to "Add a new bookmark", new_list_bookmark_path(@list), class: "btn-primary" %>
<%= link_to "Back to all lists", lists_path %>
