<h1>All Lists</h1>
<div style="margin-bottom: 20px;">
  <%= link_to "Create New List", new_list_path %>
</div>
<% @lists.each do |list| %>
  <div class="card-product">
    <%= cl_image_tag list.photo.key, height: 150, width: 100, crop: :fill %>
    <div class="card-product-infos">
      <h2><%= link_to list.name, list_path(list) %></h2>
      <p><small>(<%= list.bookmarks.count %> bookmarks)</small></p>
    </div>
    <%= button_to "Delete",
        list_path(list),
        method: :delete,
        form: { style: "display:inline-block;", data: { turbo_confirm: "Are you sure you want to delete this list?" } },
        class: "btn btn-danger"
    %>
  </div>
<% end %>
