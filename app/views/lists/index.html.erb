<h1>All Lists</h1>
<div style="margin-bottom: 20px;">
  <%= link_to "Create New List", new_list_path %>
</div>
<ul>
  <% @lists.each do |list| %>
    <li>
      <%= link_to list.name, list_path(list) %>
      <small>(<%= list.bookmarks.count %> bookmarks)</small>
      <%= button_to "Delete",
          list_path(list),
          method: :delete,
          form: { style: "display:inline-block;", data: { turbo_confirm: "Are you sure you want to delete this list?" } },
          class: "btn btn-danger"
      %>
    </li>
  <% end %>
</ul>
